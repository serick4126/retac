# --- 開発環境・生成物（適時追加） ---
/.venv
__pycache__/
*.pyc
.pytest_cache/
*.cmd

# --- 実運用データ（設定やdbなど、追跡しない）---
retac.settings.json
/_sandbox


# --- 参考資料（追跡しない）---
/references/*

# --- 開発ドキュメント（ディレクトリ内別リポジトリとして管理）---
/docs

# --- ツールが生成するメタデータ ---
/.claude
/.agents

# --- .NET ビルド生成物 ---
[Bb]in/
[Oo]bj/
*.user

# --- 動作確認用の使い捨てフォルダ ---
/_sandbox/

# --- 配布用の発行物（bin/obj と同じ生成物）---
/publish
